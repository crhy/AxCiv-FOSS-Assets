<Project>
  <!--
    One place to set the version. The About dialog reads it back at runtime from
    the assembly's informational version, so a release only has to be bumped here
    and in packaging/flatpak/io.github.crhy.rhYciv.metainfo.xml.
  -->
  <PropertyGroup>
    <VersionPrefix>0.7.2</VersionPrefix>
    <VersionSuffix>beta.1</VersionSuffix>
  </PropertyGroup>
</Project>
